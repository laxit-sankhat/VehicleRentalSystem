@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center py-5">
    <h1 class="display-1 fw-bold" style="color:var(--brand-primary);">404</h1>
    <h3>Page Not Found</h3>
    <p class="text-muted">The page you're looking for doesn't exist or may have been moved.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Go Home</a>
</div>