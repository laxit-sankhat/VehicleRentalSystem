@model List<VehicleRentalSystem.Models.Vehicle>

@{
    ViewData["Title"] = "Browse Vehicles";
}

<h2 class="mb-4">Browse Vehicles</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <select name="type" class="form-select">
            <option value="">All Types</option>
            @foreach (var t in Enum.GetValues(typeof(VehicleRentalSystem.Models.VehicleType)))
            {
                <option value="@t" selected="@(ViewBag.SelectedType?.ToString() == t.ToString())">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <input type="number" name="minPrice" class="form-control" placeholder="Min Price" value="@ViewBag.MinPrice" />
    </div>
    <div class="col-md-3">
        <input type="number" name="maxPrice" class="form-control" placeholder="Max Price" value="@ViewBag.MaxPrice" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var vehicle in Model)
    {
        <div class="col">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                {
                    <img src="@vehicle.ImageUrl" class="card-img-top" alt="@vehicle.Name" style="height:200px; object-fit:cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height:200px;">
                        No Image
                    </div>
                }

                <div class="card-body">
                    <h5 class="card-title">@vehicle.Name</h5>
                    <p class="card-text text-muted mb-1">@vehicle.Model &middot; @vehicle.Type</p>
                    <p class="card-text mb-1">Reg#: @vehicle.RegistrationNumber | Year: @vehicle.ManufacturingYear</p>
                    <p class="card-text mb-1">Fuel: @vehicle.FuelType | Trans: @vehicle.Transmission</p>
                    <p class="card-text mb-1">Seats: @vehicle.Capacity | Mileage: @vehicle.Mileage km/l</p>
                    @if (vehicle.HasSunroof)
                    {
                        <span class="badge bg-info text-dark mb-2">Sunroof</span>
                    }
                    <p class="card-text fw-bold">₹@vehicle.PricePerDay / day</p>

                    <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-outline-secondary w-100 mb-2">View Details</a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Customer"))
                    {
                        <a asp-controller="Booking" asp-action="Create" asp-route-vehicleId="@vehicle.Id" class="btn btn-primary w-100">Book Now</a>
                    }
                    else if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary w-100">Login to Book</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">No vehicles available right now.</p>
}